{
  "name": "frontend-template",
  "version": "0.1.0",
  "description": "Minimal Bun + TypeScript + React template for web projects",
  "type": "module",
  "scripts": {
    "dev": "bun index.html",
    "build": "bun build index.html --outdir dist/ --target browser",
    "start": "bun index.html",
    "tsc": "tsc --pretty --noEmit",
    "format": "biome format --write .",
    "biome": "biome check --error-on-warnings .",
    "knip": "knip",
    "checks": "bun run format && concurrently -g -c auto 'bun run tsc' 'bun run biome' 'bun run knip'",
    "test": "bun test",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "bun-types": "latest",
    "concurrently": "^10.0.3",
    "knip": "^6.16.1",
    "typescript": "^5.7.0"
  }
}
